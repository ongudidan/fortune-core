{
    "name": "ongudidan/fortune-core",
    "description": "Unified enterprise core suite for Fortune Devs: Multi-2FA, payment accounts, cash vault denominations, customer/supplier wallets, M-Pesa Daraja STK/C2B automation, double-entry general ledger, and bulk/system SMS.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ongudidan",
            "email": "ongudidan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0",
        "illuminate/mail": "^11.0|^12.0",
        "illuminate/queue": "^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.8",
        "ongudidan/laravel-multi-2fa": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "laravel/pint": "^1.18"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Required when using Vue 3 / Inertia frontend components (^1.0|^2.0).",
        "laravel/fortify": "Required for backend TOTP authentication (^1.20|^1.30).",
        "laravel/passkeys": "Required for WebAuthn passkey authentication (^0.1|^0.2)."
    },
    "autoload": {
        "psr-4": {
            "Ongudidan\\FortuneCore\\": "src/",
            "Ongudidan\\FortuneCore\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ongudidan\\FortuneCore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ongudidan\\FortuneCore\\FortuneCoreServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
